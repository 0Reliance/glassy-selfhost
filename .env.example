# Glassy self-host — copy to `.env` and fill in the required fields.
# Required: GLASSY_MEMBER_EMAIL, GLASSY_SELFHOST_TOKEN, JWT_SECRET,
#            API_KEY_ENCRYPTION_KEY
# Clear members also set: GLASSY_VERIFY_CLOUD_URL=https://clear.glassy.fyi
# All other variables have safe defaults baked into docker-compose.yml;
# uncomment + customize any of these as needed.
#
# MAINTAINERS: This file is the source of truth. After any change, sync
# to github.com/0Reliance/glassy-selfhost — see MAINTAINING.md.

# ── Required: Glassy membership ────────────────────────────────────────────
# Your Glassy account email (Clear or Pro). The appliance verifies your
# membership at boot and will not start without a valid subscription.
# Sign up at https://clear.glassy.fyi or https://glassy.fyi if needed.
GLASSY_MEMBER_EMAIL=

# ── Required: self-host pairing token ───────────────────────────────────────
# Prevents anyone who merely knows your email from spinning up an unlocked
# instance using your membership. Generate a token in your Glassy account at
# Settings → Self-hosting, then paste it here.
#   • Public/Pro members: https://app.glassy.fyi/#/settings?g=account&s=selfhost
#   • Clear members:     https://clear.glassy.fyi/#/settings?g=account&s=selfhost
# The token is stored hashed on the cloud; only you see the raw value once.
# Rotate it any time from the same settings page (the old token stops working
# on the next 30-day re-verification, or immediately if you destroy the cache).
GLASSY_SELFHOST_TOKEN=

# ── Cloud verification server ─────────────────────────────────────────────
# The appliance verifies your membership against this cloud URL. Public/Pro
# members can leave this as the default (https://app.glassy.fyi). Clear members
# must set this to https://clear.glassy.fyi so the appliance talks to the cloud
# instance where their Clear membership and pairing token live.
# This value is pinned by the operator, not arbitrary: the cloud must hold
# your account and the appliance image must be built with the matching
# SELFHOST_SIGNING_KEY for cache signatures to verify.
GLASSY_VERIFY_CLOUD_URL=https://app.glassy.fyi

# ── Optional: Cloud Sync token (cross-instance data sync) ───────────────────
# Generate a sync token in your Glassy cloud account under Settings → Cloud Sync
# and paste it here to enable two-way sync of notes, documents, bookmarks, etc.
# between this appliance and your cloud account. Separate from the pairing
# token above — rotates independently. Leave blank to disable sync.
#   • Public/Pro: https://app.glassy.fyi/#/settings?g=account&s=cloud-sync
#   • Clear members: https://clear.glassy.fyi/#/settings?g=account&s=cloud-sync
GLASSY_SYNC_TOKEN=

# Sync interval in milliseconds (default: 300000 = 5 minutes). Set to 0 to
# disable automated sync (manual "Sync now" in Settings still works).
GLASSY_SYNC_INTERVAL_MS=300000

# Fast-check interval in milliseconds (default: 10000 = 10s). When there are
# pending outbound changes, the scheduler runs an immediate sync cycle instead
# of waiting for the full interval. Set to 0 to disable fast-check (full
# interval still runs).
GLASSY_SYNC_CHECK_MS=10000

# ── Required: two secrets (generate with `openssl rand -hex 32`) ────────────
# ⚠️ JWT_SECRET signs every login session. If you reinstall (or reuse this .env
# after a destructive cleanout), generate a NEW JWT_SECRET — reusing the old one
# lets a browser still holding a token from the previous install authenticate
# against the fresh one (same email + user id), skipping the first-login flow.
JWT_SECRET=
API_KEY_ENCRYPTION_KEY=

# ── Core identity / URLs ────────────────────────────────────────────────────
# APP_URL is the public origin Glassy tells OAuth + email links to use.
# For Tailscale / LAN access, set this to your tailnet or LAN URL.
APP_URL=http://localhost:3000

# Comma-separated origins allowed to call the API. Defaults to localhost.
# For Tailscale / multi-device, add your tailnet hostname or LAN origin here,
# e.g. CORS_ORIGINS=http://localhost:3000,http://glassy.tail-net.ts.net:3000
CORS_ORIGINS=http://localhost:3000

# ── Tailscale trusted HTTPS (optional, recommended for multi-device) ─────────
# After `sudo tailscale up --hostname glassy` and
#   `sudo tailscale serve --bg --https 443 http://localhost:3000`
# Glassy is at https://glassy.tailnet.ts.net with a trusted Let's Encrypt cert
# on every device on your tailnet. Set:
#   APP_URL=https://glassy.tailnet.ts.net
#   CORS_ORIGINS=https://glassy.tailnet.ts.net
# Then `docker compose up -d` to pick up the new CORS origin. With this path,
# the Obsidian bridge becomes optional — the server can reach Obsidian directly
# via the tailnet IP. See SELF_HOSTED_DEPLOYMENT.md § 7.

# Glassy image tag from GHCR. Required: set to the latest released version
# (see https://github.com/0Reliance/glassy/releases) — never `latest`, which is
# the hosted build and omits self-host features.
GLASSY_TAG=v2.36.0-beta.32

# Host port Glassy listens on. Change this if port 3000 is already in use
# (e.g. by another dev tool). When you change it, also update APP_URL and
# CORS_ORIGINS below to match. The container always listens on 8080 internally;
# this only changes the host-side mapping.
APP_PORT=3000

# ── Single-user defaults ────────────────────────────────────────────────────
# Private mode hides all public surfaces from logged-out visitors.
# The seeded admin account is the only account on this instance.
#
# ⚠️  NOTE: INSTANCE_ID and INSTANCE_ACCESS_MODE_DEFAULT are hardcoded in
# docker-compose.yml and CANNOT be overridden here. They are security
# boundaries — overriding them via .env could turn your private appliance
# into a public instance. This entry is for reference only.
INSTANCE_ACCESS_MODE_DEFAULT=private

# Registration is permanently disabled on the single-user appliance.
# The server enforces this regardless of any setting here — do not add
# an ALLOW_REGISTRATION line. To run more than one workspace, create
# sub-accounts from Settings → Accounts (one owner, isolated workspaces).
# See docs/SELF_HOSTED_DEPLOYMENT.md § Account management.

# Tells the app it's running locally (hides the cloud-limitation banner
# in Obsidian settings, etc.). Do not change.
DEPLOYMENT_LOCALITY=local

# ── Feature flags — Second Brain / MCP full stack ───────────────────────────
# All 6 flags work together. Defaults are true (set in docker-compose.yml).
# Override any to false to disable a specific layer.
ENABLE_CORPUS_INDEXER=true
ENABLE_KB_QUERY=true
ENABLE_MCP_SERVER=true
ENABLE_HYBRID_SEARCH=true
ENABLE_MCP_BRIDGE=true

# Agent Gateway (OpenClaw / Hermes). Self-host-appropriate (requires localhost).
ENABLE_AGENT_GATEWAY=true

# BYOK — "bring your own key". Server-side gate for POST/DELETE/PATCH/validate
# on /api/api-keys. DEFAULT OFF IN CODE because on the cloud it would bypass the
# AI cost cap; on the appliance the operator owns the keys, so it is on here.
# (The matching client flag VITE_ENABLE_BYOK is baked into versioned images.)
# Without it the API keys (BYOK) settings section is visible but every save
# returns 403 BYOK_DISABLED.
ENABLE_BYOK=true

# Calendar automation — event-triggered agent dispatch + rule time triggers.
# Off by default on hosted tiers; enabled here because the appliance unlocks
# all Pro features. Requires ENABLE_AGENT_GATEWAY=true for dispatch actions.
# See docs/CALENDAR_AUTOMATION.md.
ENABLE_CALENDAR_AUTOMATION=true

# ── Web Push (VAPID): NOT available on the appliance ──────────────────────────
# Do not set these. /api/push/* is deliberately never mounted on self-host
# (server/index.js) and the Push Notifications settings panel is hidden to match,
# so nothing reads a VAPID key here. Reminders still fire in-app over SSE.
# If browser push is ever enabled for self-host, add these keys back together with
# the route mount — see SELF_HOSTED_DEPLOYMENT.md §13.

# ── Host networking ─────────────────────────────────────────────────────────
# Rewrites 127.0.0.1 to the Docker host gateway so container can reach
# Obsidian / Ollama on the host. Do not change.
OBSIDIAN_HOST_OVERRIDE=host.docker.internal

# Additional hostnames/IPs allowed for Obsidian Local REST API connections.
# Comma-separated. Use this when Obsidian is on a different machine (LAN IP),
# a Tailscale node, or a WSL2 bridge address that the default allowlist
# doesn't cover. Self-hosted only — ignored on cloud instances.
# Example: OBSIDIAN_NETWORK_ALLOWLIST=192.168.1.10,glassy.tail-net.ts.net
# OBSIDIAN_NETWORK_ALLOWLIST=

# ── AI providers ────────────────────────────────────────────────────────
# Local AI works out of the box: in-browser WebGPU models, or Ollama on the
# host (reachable via host.docker.internal). No key required.
#
# For cloud AI (Gemini / OpenAI / Anthropic), add your own key IN THE APP at
# Settings → API Keys (BYOK). On the appliance, cloud API keys are NOT read
# from this file — they are stored encrypted per-account in the database.

# Ollama endpoint for local AI. Inside the container, `localhost` is the
# container itself — use host.docker.internal to reach Ollama on the host.
# The server auto-appends /v1 if missing, so both with and without /v1 work.
# If using the bundled ollama sidecar (docker-compose.ollama.yml), use
# http://ollama:11434 instead.
# docker-compose.yml already sets this default; uncomment to override.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Chat / generation model. Ollama tags are EXACT: `llama3.2` means
# `llama3.2:latest` and will 404 against a machine that pulled `llama3.2:3b`.
# Run `ollama list` and copy the tag verbatim. Reachable here via `env_file` —
# docker-compose.yml also names it explicitly for `docker inspect` visibility.
OLLAMA_MODEL=llama3.2

# Embeddings use a SEPARATE model from chat. Leave unset and Glassy probes
# /api/tags once and picks the best embedding model you already have
# (nomic-embed-text, mxbai-embed-large, bge-m3, qwen3-embedding, …), so a stock
# appliance needs no configuration. Set it explicitly to pin one:
# OLLAMA_EMBEDDING_MODEL=nomic-embed-text
#
# Do NOT point this at your chat model. A chat model's vectors are both lower
# quality and a different WIDTH than an embedding model's, and mixing widths in
# one table silently disables semantic search (mismatched vectors are skipped).
# If you change this later, re-index: see SELF_HOSTED_DEPLOYMENT.md
# → "Re-indexing embeddings", and check /api/monitoring/ready → embeddingHealth.

# ── Advanced (all optional — the commented value IS the built-in default) ─────
# Timezone for EVERY cron schedule: the 2 AM daily backup, the 3:15 AM outbox
# purge, the 6 AM health check, the hourly ICS sync at :05. Without this the
# appliance runs on UTC, so "back up at 2 AM" means 2 AM UTC.
# TZ=UTC

# ── Embeddings ────────────────────────────────────────────────────────────────
# Which provider and model generate the vectors behind semantic search and the
# Second Brain corpus. GLASSY_EMBEDDING_PROVIDER=ollama keeps everything on your
# own hardware (and then OLLAMA_EMBEDDING_MODEL picks the tag, or is auto-probed).
# GLASSY_EMBEDDING_PROVIDER=gemini
# GLASSY_EMBEDDING_MODEL=gemini-embedding-001

# WARNING: changing the provider or model changes the VECTOR WIDTH, and vectors
# are only comparable within one width. Every previously stored vector then becomes
# unusable and semantic search quietly returns less (often nothing) while still
# answering 200. Read "Re-indexing embeddings" in SELF_HOSTED_DEPLOYMENT.md before
# you change either, and check /api/monitoring/ready -> embeddingHealth afterwards.

# ── Bundled cloud model selection ─────────────────────────────────────────────
# Applies only when a system Gemini key is configured (BYOK keys are stored
# encrypted in the database, not here, and are selected per provider in the UI).
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Sweep dormant accounts for inactivity. Off by default and OFF on the appliance
# by design — it is a multi-tenant housekeeping job, and the appliance is
# single-user (beta.30 also removed the misleading registration UI toggle).
# ENABLE_INACTIVITY_SWEEPER=false

# ── Transactional email (disabled on the appliance) ─────────────────────────
# Email is permanently OFF on the self-hosted appliance — nothing leaves the
# machine, so these variables are no-ops here. Password reset uses the local
# recovery paths instead (admin reset, or secret recovery key — see
# docs/SELF_HOSTED_DEPLOYMENT.md § Account recovery).
# RESEND_API_KEY=
# EMAIL_FROM=Glassy <noreply@glassy.fyi>
# EMAIL_REPLY_TO=support@glassy.fyi

# ── Optional infra ──────────────────────────────────────────────────────────
# TRUST_PROXY=2                       # set to 1 if behind a single reverse proxy
#
# Glassy always takes an automatic daily backup at 02:00 (plain SQLite copies
# in /app/data/backups, ~7 days kept) — no config needed. The variables below
# only affect the on-demand backup CLI (`node server/utils/backup.js`):
# BACKUP_DIR=/app/data/backups        # where the CLI writes (default shown)
# BACKUP_RETENTION_DAYS=30            # CLI retention in days (default 30)
# Encrypt CLI backups (recommended for off-machine copies). Generate with
# `openssl rand -hex 32` and store the key somewhere safe OFF the machine —
# without it, encrypted backups cannot be restored.
# BACKUP_ENCRYPTION_KEY=

# ── Advanced tuning (optional) ──────────────────────────────────────────────
# Worker processes. The self-host compose pins CLUSTER_WORKERS=1 by default
# for deterministic first-boot seeding and clean logs. Raise on a multi-core
# host only if you understand the trade-off.
# CLUSTER_WORKERS=2

# MCP tool-call rate limits (per hour). The self-host owner is on the Pro
# tier, so the PRO limit applies. Raise it if heavy agent/MCP automation
# hits the ceiling; there is no billing on the appliance.
# MCP_PRO_TOOLCALLS_PER_HOUR=1200
# MCP_FREE_TOOLCALLS_PER_HOUR=120

# Obsidian tuning — raise the timeout for a slow host or a large vault, and
# the import caps if you import a big vault in one go.
# OBSIDIAN_REQUEST_TIMEOUT_MS=10000       # per-request timeout (ms)
# OBSIDIAN_IMPORT_MAX_ENTRIES=5000        # max notes per import
# OBSIDIAN_IMPORT_MAX_TOTAL_BYTES=209715200   # 200 MB total per import
# OBSIDIAN_IMPORT_MAX_PER_FILE_BYTES=5242880  # 5 MB per file